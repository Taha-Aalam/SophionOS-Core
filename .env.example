# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# App
# Public origin the APPLICATION (app. subdomain) is served from (no trailing
# slash). The apex host serves marketing only and redirects app routes here.
# Dev: http://app.localhost:3000  |  Prod: https://app.<your-domain>
NEXT_PUBLIC_APP_URL=

# Billing webhooks (HMAC or Bearer). Required for POST /api/v1/billing/webhook.
BILLING_WEBHOOK_SECRET=

# Rate limit store: omit for Postgres shared counters; set "memory" for tests.
# RATE_LIMIT_STORE=memory
