# =============================================================================
# SophionOS environment template — placeholders only, never real secrets.
# Copy to .env.local and fill in values for your deployment.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project URL, e.g. https://xxxx.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — safe for browser with RLS; still treat as project-specific
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (required) --------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- App (required for correct host routing) ---------------------------------
# Public origin the APPLICATION is served from (no trailing slash). This is the
# single source of truth for which host runs the app — there is no hardcoded
# subdomain prefix, so set it to whatever host you want the app on:
#   Dev:  http://localhost:3000  or  https://dev.sophionos.com
#   Prod: https://app.sophionos.com
# Any other host is treated as the apex/marketing host and app routes redirect
# here. When unset, the app runs in single-host mode on the current host.
NEXT_PUBLIC_APP_URL=

# --- Billing webhooks (optional) ---------------------------------------------
# HMAC or Bearer secret for POST /api/v1/billing/webhook. Leave empty if unused.
BILLING_WEBHOOK_SECRET=

# --- Rate limiting (optional) ------------------------------------------------
# Omit for Postgres shared counters; set "memory" for tests/single-process.
# RATE_LIMIT_STORE=memory

# --- Build tooling (optional) ------------------------------------------------
# ANALYZE=true

# --- Email briefs (optional until enabled) ----------------------------------
# Shared secret: Supabase pg_net Authorization Bearer must match.
CRON_SECRET=
# Resend API key + verified sender, e.g. SophionOS <briefs@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Public URL pg_cron will call (usually same origin as NEXT_PUBLIC_APP_URL)
# Example: https://app.example.com/api/cron/briefs
BRIEFS_CRON_URL=

# ---------- Founding Cohort membership (marketing site integration) ----------
# Base URL of the sophionos-landing site and the shared secret it expects as
# the x-cohort-key header on GET /api/cohort/membership. Must match the
# landing site's COHORT_MEMBERSHIP_SECRET.
# COHORT_MEMBERSHIP_URL=http://localhost:3000
# COHORT_MEMBERSHIP_SECRET=change-me-to-a-long-random-string
