# =============================================================================
# SophionOS environment template — placeholders only, never real secrets.
# Copy to .env.local and fill in values for your deployment.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project URL, e.g. https://xxxx.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — safe for browser with RLS; still treat as project-specific
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (required) --------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- App (required for correct host routing) ---------------------------------
# Public origin the APPLICATION (app. subdomain) is served from (no trailing
# slash). Apex host may serve marketing only and redirect app routes here.
# Dev: http://app.localhost:3000  |  Prod: https://app.example.com
NEXT_PUBLIC_APP_URL=

# --- Billing webhooks (optional) ---------------------------------------------
# HMAC or Bearer secret for POST /api/v1/billing/webhook. Leave empty if unused.
BILLING_WEBHOOK_SECRET=

# --- Rate limiting (optional) ------------------------------------------------
# Omit for Postgres shared counters; set "memory" for tests/single-process.
# RATE_LIMIT_STORE=memory

# --- Build tooling (optional) ------------------------------------------------
# ANALYZE=true
