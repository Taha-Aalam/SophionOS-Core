{
  "name": "@sophionos/mcp-server",
  "version": "0.1.0",
  "description": "MCP server that wraps the SophionOS Core REST API — connect SophionOS to any MCP-compatible AI client.",
  "type": "module",
  "bin": {
    "sophionos-mcp": "./dist/index.js"
  },
  "files": [
